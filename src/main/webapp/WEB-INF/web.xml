<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
  <display-name>Archetype Created Web Application</display-name>

  <servlet>
    <servlet-name>RegisterServlet</servlet-name>
    <servlet-class>com.usermanagementsys.controller.RegisterServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>com.usermanagementsys.controller.LoginServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>LogoutServlet</servlet-name>
    <servlet-class>com.usermanagementsys.controller.LogoutServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>EditUserServlet</servlet-name>
    <servlet-class>com.usermanagementsys.controller.EditUserServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>DeleteUserServlet</servlet-name>
    <servlet-class>com.usermanagementsys.controller.DeleteUserServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>ForgotPasswordServlet</servlet-name>
    <servlet-class>com.usermanagementsys.controller.ForgotPasswordServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>ResetPasswordServlet</servlet-name>
    <servlet-class>com.usermanagementsys.controller.ResetPasswordServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>VerifyTempPasswordServlet</servlet-name>
    <servlet-class>com.usermanagementsys.controller.VerifyTempPasswordServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>RegisterServlet</servlet-name>
    <url-pattern>/register</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>LogoutServlet</servlet-name>
    <url-pattern>/logout</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>EditUserServlet</servlet-name>
    <url-pattern>/edit_user</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>DeleteUserServlet</servlet-name>
    <url-pattern>/delete_user</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>ForgotPasswordServlet</servlet-name>
    <url-pattern>/forgot_password</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>ResetPasswordServlet</servlet-name>
    <url-pattern>/reset_password</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>VerifyTempPasswordServlet</servlet-name>
    <url-pattern>/verify_temp_password</url-pattern>
  </servlet-mapping>

</web-app>
